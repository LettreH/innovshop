<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; color: #222;">

    <h1 style="background: #212529; color: #fff; padding: 20px; margin: 0;">
        🚀 InnovShop
    </h1>

    <div style="padding: 20px; border: 1px solid #ddd;">
        <p>Bonjour {{ commande.utilisateur.prenom }},</p>

        <p>
            Merci pour votre commande ! Voici votre récapitulatif.<br>
            <strong>Numéro :</strong> {{ commande.numero }}<br>
            <strong>Date :</strong> {{ commande.dateCommande|date('d/m/Y à H:i') }}
        </p>

        <table style="width: 100%; border-collapse: collapse;">
            <tr style="background: #f1f1f1;">
                <th style="text-align: left; padding: 8px;">Produit</th>
                <th style="text-align: left; padding: 8px;">Option</th>
                <th style="text-align: right; padding: 8px;">Prix</th>
            </tr>
            {% for ligne in commande.lignes %}
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 8px;">{{ ligne.nomProduit }}</td>
                    <td style="padding: 8px;">{{ ligne.optionChoisie ?? '—' }}</td>
                    <td style="padding: 8px; text-align: right;">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="2" style="padding: 8px;"><strong>Total</strong></td>
                <td style="padding: 8px; text-align: right;">
                    <strong>{{ commande.montantTotal|number_format(2, ',', ' ') }} €</strong>
                </td>
            </tr>
        </table>

        <p style="margin-top: 20px;">
            <strong>Livraison à :</strong><br>
            {{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}<br>
            {{ commande.adresse.rue }}<br>
            {{ commande.adresse.codePostal }} {{ commande.adresse.ville }}<br>
            {{ commande.adresse.pays }}
        </p>

        <p>Nous vous préviendrons dès l'expédition de votre colis.</p>
        <p>À bientôt dans le futur,<br>L'équipe InnovShop</p>
    </div>
</div>