{% extends 'base.html.twig' %}

{% block title %}Mot de passe - InnovShop{% endblock %}

{% block body %}
    <h1 class="mb-4">Changer mon mot de passe</h1>

    <div class="row g-4">
        <div class="col-12 col-md-3">
            {{ include('compte/_menu.html.twig', {actif: 'mot_de_passe'}) }}
        </div>

        <div class="col-12 col-md-9">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
                        {{ form_row(form.ancienMotDePasse) }}
                        <hr>
                        {{ form_row(form.nouveauMotDePasse.first) }}
                        {{ form_row(form.nouveauMotDePasse.second) }}
                        <button type="submit" class="btn btn-primary">Changer mon mot de passe</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}