{% extends 'base.html.twig' %}

{% block title %}Mon compte - InnovShop{% endblock %}

{% block body %}
    <h1 class="mb-4">Bonjour {{ app.user.prenom }} 👋</h1>

    <div class="row g-4">
        <div class="col-12 col-md-3">
            {{ include('compte/_menu.html.twig', {actif: 'accueil'}) }}
        </div>

        <div class="col-12 col-md-9">
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">👤 Mes informations</h2>
                            <p>
                                {{ app.user.prenom }} {{ app.user.nom }}<br>
                                {{ app.user.email }}<br>
                                📞 {{ app.user.telephone ?? 'Non renseigné' }}
                            </p>
                            <a href="{{ path('app_compte_profil') }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">📦 Mes commandes</h2>
                            <p class="display-6 mb-0">{{ commandes|length }}</p>
                            <p class="text-muted mb-0">commande(s) passée(s)</p>
                        </div>
                    </div>
                </div>
            </div>

            <h2 class="h4 mb-3">Mes dernières commandes</h2>
            {% if commandes is empty %}
                <div class="alert alert-info">
                    Vous n'avez pas encore passé de commande.
                    <a href="{{ path('app_catalogue') }}" class="alert-link">Découvrir le catalogue</a>
                </div>
            {% else %}
                {{ include('compte/_tableau_commandes.html.twig', {commandes: commandes|slice(0, 3)}) }}
                <a href="{{ path('app_compte_commandes') }}">Voir toutes mes commandes →</a>
            {% endif %}
        </div>
    </div>
{% endblock %}