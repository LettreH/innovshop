{% extends 'base.html.twig' %}

{% block title %}Mes adresses - InnovShop{% endblock %}

{% block body %}
    <h1 class="mb-4">Mes adresses</h1>

    <div class="row g-4">
        <div class="col-12 col-md-3">
            {{ include('compte/_menu.html.twig', {actif: 'adresses'}) }}
        </div>

        <div class="col-12 col-md-9">
            <a href="{{ path('app_compte_adresse_nouvelle') }}" class="btn btn-primary mb-3">+ Ajouter une adresse</a>

            {% if adresses is empty %}
                <div class="alert alert-info">Vous n'avez encore aucune adresse enregistrée.</div>
            {% else %}
                <div class="row g-3">
                    {% for adresse in adresses %}
                        <div class="col-12 col-lg-6">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <p>
                                        {{ adresse.rue }}<br>
                                        {{ adresse.codePostal }} {{ adresse.ville }}<br>
                                        {{ adresse.pays }}
                                    </p>

                                    {% if adresse.id in verrouillees %}
                                        <p class="mt-auto mb-0">
                                            <span class="badge bg-secondary">🔒 Utilisée pour une commande</span>
                                        </p>
                                    {% else %}
                                        <div class="mt-auto d-flex gap-2">
                                            <a href="{{ path('app_compte_adresse_modifier', {id: adresse.id}) }}"
                                               class="btn btn-sm btn-outline-primary">Modifier</a>

                                            <form method="post"
                                                  action="{{ path('app_compte_adresse_supprimer', {id: adresse.id}) }}"
                                                  onsubmit="return confirm('Supprimer cette adresse ?');"
                                                  data-turbo="false">
                                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-adresse-' ~ adresse.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}