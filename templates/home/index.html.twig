{% extends 'base.html.twig' %}

{% block title %}InnovShop - Le futur, livré chez vous{% endblock %}

{% block body %}

    {# ===== 1. Bandeau de bienvenue ===== #}
    <section class="p-5 mb-5 bg-dark text-white rounded-3 text-center">
        <h1 class="display-5 fw-bold">🚀 Bienvenue chez InnovShop</h1>
        <p class="lead">Les objets du futur, disponibles dès aujourd'hui.</p>
        <a href="{{ path('app_catalogue') }}" class="btn btn-primary btn-lg">
            Découvrir le catalogue
        </a>
    </section>

    {# ===== 2. Produits à la une ===== #}
    <section class="mb-5">
        <h2 class="mb-4">⭐ À la une</h2>
        <div class="row g-4">
            {% for produit in produitsALaUne %}
                <div class="col-12 col-sm-6 col-lg-4">
                    {{ include('produit/_carte.html.twig') }}
                </div>
            {% else %}
                <p class="text-muted">Aucun produit à la une pour le moment.</p>
            {% endfor %}
        </div>
    </section>

    {# ===== 3. Nouveautés ===== #}
    <section class="mb-5">
        <h2 class="mb-4">🆕 Nouveautés</h2>
        <div class="row g-4">
            {% for produit in nouveautes %}
                <div class="col-12 col-sm-6 col-lg-4">
                    {{ include('produit/_carte.html.twig') }}
                </div>
            {% else %}
                <p class="text-muted">Aucune nouveauté pour le moment.</p>
            {% endfor %}
        </div>
    </section>

{% endblock %}