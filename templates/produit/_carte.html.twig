<div class="card h-100 shadow-sm">
    {% if produit.image %}
    <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" loading="lazy">    {% endif %}

    <div class="card-body d-flex flex-column">
        <span class="badge bg-secondary align-self-start mb-2">{{ produit.categorie.nom }}</span>
        <h3 class="h5 card-title">{{ produit.nom }}</h3>
        <p class="card-text text-muted small">{{ produit.description|slice(0, 90) }}...</p>
        <p class="fs-5 fw-bold mt-auto">{{ produit.prix|number_format(2, ',', ' ') }} €</p>

        <div class="d-flex gap-2">
            <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn btn-outline-primary flex-fill">
                Voir le produit
            </a>

            {% if produit.options is empty %}
                {# Pas d'option à choisir : ajout direct #}
                <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}" data-turbo="false" class="js-panier">                    <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                    <button type="submit" class="btn btn-success" title="Ajouter au panier">🛒</button>
                </form>
            {% else %}
                {# Des options à choisir : on envoie vers la fiche #}
                <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn btn-success" title="Choisir les options">🛒</a>
            {% endif %}
        </div>
    </div>
</div>