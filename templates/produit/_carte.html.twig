{# Carte d'un produit, reutilisee sur le catalogue et l'accueil #}
<div class="card h-100 shadow-sm">

    {% if produit.image %}
        <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
             class="card-img-top" alt="{{ produit.nom }}">
    {% endif %}

    <div class="card-body d-flex flex-column">
        <span class="badge bg-secondary align-self-start mb-2">{{ produit.categorie.nom }}</span>
        <h3 class="h5 card-title">{{ produit.nom }}</h3>
        <p class="card-text text-muted">{{ produit.description|slice(0, 90) }}...</p>
        <p class="fs-5 fw-bold mb-3 mt-auto">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
        <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn btn-primary">Voir le produit</a>
    </div>

</div>
