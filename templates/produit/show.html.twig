{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} - InnovShop{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_catalogue') }}">Catalogue</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ produit.nom }}</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-12 col-md-6">
            {% if produit.image %}
                <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
                     alt="{{ produit.nom }}" class="img-fluid rounded shadow-sm">
            {% endif %}
        </div>

        <div class="col-12 col-md-6">
            <span class="badge bg-secondary">{{ produit.categorie.nom }}</span>
            {% if produit.alaUne %}
                <span class="badge bg-warning text-dark">⭐ À la une</span>
            {% endif %}

            <h1 class="mt-2">{{ produit.nom }}</h1>
            <p class="fs-3 fw-bold text-primary">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
            <p class="lead">{{ produit.description }}</p>

            {# Formulaire d'ajout au panier #}
            <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}" data-turbo="false" class="js-panier">                {% for nom, valeurs in produit.optionsGroupees %}
                    <div class="mb-3">
                        <label for="option-{{ loop.index }}" class="form-label fw-semibold">{{ nom }}</label>
                        <select id="option-{{ loop.index }}" name="options[{{ nom }}]" class="form-select">
                            {% for valeur in valeurs %}
                                <option value="{{ valeur }}">{{ valeur }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}

                <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                <button type="submit" class="btn btn-success btn-lg">🛒 Ajouter au panier</button>
            </form>

            <a href="{{ path('app_catalogue') }}" class="btn btn-link mt-3 px-0">← Retour au catalogue</a>
        </div>
    </div>
{% endblock %}