{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} - InnovShop{% endblock %}

{% block body %}

    {# Le fil d'Ariane : ou suis-je ? #}
    <nav aria-label="Fil d'Ariane" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_catalogue') }}">Catalogue</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ produit.nom }}</li>
        </ol>
    </nav>

    <div class="row g-5">

        {# Colonne gauche : l'image #}
        <div class="col-12 col-md-6">
            {% if produit.image %}
                <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
                     class="img-fluid rounded shadow" alt="{{ produit.nom }}">
            {% endif %}
        </div>

        {# Colonne droite : les informations #}
        <div class="col-12 col-md-6">
            <span class="badge bg-secondary mb-2">{{ produit.categorie.nom }}</span>
            {% if produit.alaUne %}
                <span class="badge bg-warning text-dark mb-2">⭐ À la une</span>
            {% endif %}

            <h1>{{ produit.nom }}</h1>
            <p class="fs-3 fw-bold text-primary">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
            <p class="lead">{{ produit.description }}</p>

            {# Les options, rangees par nom #}
            {% for nomOption, valeurs in produit.optionsGroupees %}
                <label for="option-{{ loop.index }}" class="form-label fw-semibold">{{ nomOption }}</label>
                <select id="option-{{ loop.index }}" class="form-select mb-3">
                    {% for valeur in valeurs %}
                        <option>{{ valeur }}</option>
                    {% endfor %}
                </select>
            {% endfor %}

            <button class="btn btn-primary btn-lg w-100" disabled>Ajouter au panier (bientôt)</button>

            <a href="{{ path('app_catalogue') }}" class="btn btn-link mt-3">← Retour au catalogue</a>
        </div>

    </div>
{% endblock %}
